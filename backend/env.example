# Application Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
USE_MOCK_DB=true

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/aicyber_platform
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aicyber_platform
DATABASE_USER=username
DATABASE_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production
COOKIE_SECRET=your-cookie-secret-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@aicyber-platform.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Monitoring and Analytics
ENABLE_METRICS=true
METRICS_PORT=9090

# External Services
THREAT_INTELLIGENCE_API_KEY=your-api-key
VIRUSTOTAL_API_KEY=your-api-key
ABUSEIPDB_API_KEY=your-api-key

# Encryption Keys (for production, use proper key management)
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_ALGORITHM=AES-256-GCM

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Compliance Configuration
ENABLE_AUDIT_LOGS=true
AUDIT_LOG_RETENTION_DAYS=365
GDPR_COMPLIANCE=true
PCI_COMPLIANCE=false

# Development Configuration
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_GRAPHIQL=true 