{
  "name": "@aicyber-platform/backend",
  "version": "1.0.0",
  "description": "AICyber Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "health": "curl http://localhost:3001/health",
    "health:detailed": "curl http://localhost:3001/health/detailed",
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:down": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "seed": "knex seed:run --knexfile knexfile.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "latest",
    "axios": "latest",
    "bcryptjs": "latest",
    "bull": "latest",
    "compression": "latest",
    "compromise": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "express-slow-down": "latest",
    "express-validator": "latest",
    "helmet": "latest",
    "joi": "latest",
    "jsonwebtoken": "latest",
    "knex": "latest",
    "lodash": "latest",
    "ml-matrix": "latest",
    "moment": "latest",
    "morgan": "latest",
    "natural": "latest",
    "onnxruntime-node": "latest",
    "openai": "latest",
    "pdfkit": "latest",
    "pg": "latest",
    "prom-client": "latest",
    "redis": "latest",
    "sentiment": "latest",
    "socket.io": "latest",
    "swagger-jsdoc": "latest",
    "swagger-ui-express": "latest",
    "uuid": "latest",
    "winston": "latest",
    "winston-daily-rotate-file": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "latest",
    "@types/compression": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/lodash": "latest",
    "@types/morgan": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/pg": "latest",
    "@types/redis": "latest",
    "@types/supertest": "latest",
    "@types/swagger-jsdoc": "latest",
    "@types/swagger-ui-express": "latest",
    "@types/uuid": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "jest": "latest",
    "nodemon": "latest",
    "prettier": "latest",
    "rimraf": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-node": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "api",
    "backend",
    "cybersecurity",
    "ai",
    "security",
    "machine-learning",
    "tensorflow",
    "nlp"
  ],
  "author": "AICyber Team",
  "license": "MIT"
}
